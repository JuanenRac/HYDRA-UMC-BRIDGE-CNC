# The bridge coordinates a CNC cell; it never streams a program. The configuration is /etc/hydra-umc-bridge-cnc/bridge-cnc.toml
# (example: deploy/bridge-cnc.example.toml); the MQTT credentials go in /etc/hydra-umc/bridge-cnc.env
# (HYDRA_MQTT_USERNAME=..., readable by root only).
# The account of the service cannot enter the shared /etc/hydra-umc (mode 0750, group of the agent), so systemd creates /etc/hydra-umc-bridge-cnc
# for this unit alone (mode 0750). A configuration file of the earlier place (/etc/hydra-umc/bridge-cnc.toml) is copied there once, as root, by the first
# ExecStartPre, which never overwrites and never deletes; the second ExecStartPre proves the account of the service can read it. The environment file
# may stay in /etc/hydra-umc or go to /etc/hydra-umc-bridge-cnc (systemd reads both as root).
[Unit]
Description=HYDRA-UMC-BRIDGE-CNC CNC cell coordination and job gate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-bridge-cnc
Group=hydra-umc-bridge-cnc
SupplementaryGroups=gpio dialout
WorkingDirectory=/opt/hydra-umc/bridge-cnc
# The package of the SDK (hydra_umc_sdk) is put in /opt/hydra-umc/sdk-python by the installer of HYDRA-UMC-OS (provisioning/deploy_lib.sh: provide_sdk_python).
Environment=PYTHONPATH=/opt/hydra-umc/bridge-cnc/src:/opt/hydra-umc/sdk-python
Environment=HYDRA_UMC_BRIDGE_CNC_CONFIG=/etc/hydra-umc-bridge-cnc/bridge-cnc.toml
EnvironmentFile=-/etc/hydra-umc/bridge-cnc.env
EnvironmentFile=-/etc/hydra-umc-bridge-cnc/bridge-cnc.env
ExecStartPre=+/usr/bin/python3 -m hydra_umc_bridge_cnc --prepare-config
ExecStartPre=/usr/bin/python3 -m hydra_umc_bridge_cnc --check-access
ExecStartPre=/usr/bin/python3 -m hydra_umc_bridge_cnc --check
ExecStart=/usr/bin/python3 -m hydra_umc_bridge_cnc
Restart=on-failure
RestartSec=5
StateDirectory=hydra-umc-bridge-cnc
ConfigurationDirectory=hydra-umc-bridge-cnc
ConfigurationDirectoryMode=0750
RuntimeDirectory=hydra-umc
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# the GPIO chip and the serial port are the only devices it needs
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
MemoryAccounting=yes
MemoryHigh=128M
MemoryMax=192M

[Install]
WantedBy=multi-user.target
